        "steps": [
          {
            "id": "freshness",
            "state": "active",
            "title": "Keep data fresh",
            "description": "Move from one-time collection toward regular updates, so product details and prices inspire more confidence over time."
          },
          {
            "id": "details",
            "state": "future",
            "title": "Create detailed product pages",
            "description": "Give each wheel a dedicated page with a deeper, structured view than the comparator's expandable panel."
          },
          {
            "id": "categories",
            "state": "future",
            "title": "Add new wheel categories",
            "description": "Extend beyond road wheels, starting with gravel as a first candidate, on a catalogue that can be maintained."
          },
          {
            "id": "marketplaces",
            "state": "future",
            "title": "Enrich marketplace links",
            "description": "Connect comparisons to more relevant places to find products, without becoming an ecommerce platform."
          }
        ]
      },
      {
        "id": "data-exploitation",
        "title": "Exploit the data",
        "description": "Turn a richer, more reliable catalogue into analytical decision support.",
        "steps": [
          {
            "id": "indicators",
            "state": "future",
            "title": "Derived indicators",
            "description": "Add calculated metrics such as weight/price and weight/depth ratios."
          },
          {
            "id": "visualizations",
            "state": "future",
            "title": "Multicriteria visualizations",
            "description": "Show trade-offs across several criteria and highlight multiple optimal products, including Pareto frontiers."
          },
          {
            "id": "articles",
            "state": "future",
            "title": "Data-based analysis",
            "description": "Publish observations, conclusions and recommendations grounded in the catalogue."
          }
        ]
      },
      {
        "id": "other-components",
        "state": "future",
        "title": "Extend to other components",
        "description": "Broaden the catalogue progressively to other bike component families, without fixing their order today."
      },
